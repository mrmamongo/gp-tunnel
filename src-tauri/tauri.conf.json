{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlobalProtect Remote GUI",
  "version": "0.1.0",
  "identifier": "com.globalprotect.remote-gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GlobalProtect Remote GUI",
        "width": 900,
        "height": 760,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
