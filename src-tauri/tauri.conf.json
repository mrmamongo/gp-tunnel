{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlobalProtect Remote GUI",
  "version": "0.2.5",
  "identifier": "com.globalprotect.remote-gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GlobalProtect Remote GUI",
        "label": "main",
        "width": 340,
        "height": 362,
        "visible": false,
        "focus": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
